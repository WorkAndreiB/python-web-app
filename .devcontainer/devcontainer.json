{
    // build configuration for the dev container using the specified Dockerfile and context
    "build": {
        "dockerfile": "../backend/Dockerfile",
        "context": ".."
    },

    "workspaceFolder": "/workspace",

    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",

    // make the specified port available to the host machine
    "forwardPorts": [8000, 5500],

    "postCreateCommand": "pip install -e /workspace/python/password-generator",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy"
            ]
        }
    }
}