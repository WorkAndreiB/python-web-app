FROM python:3.12-slim

WORKDIR /workspace

COPY backend/requirements.txt /workspace/requirements.txt

# Install Python dependencies from requirements.txt
RUN pip install --no-cache-dir -r /workspace/requirements.txt

COPY python/password-generator /workspace/python/password-generator

# Install the password-generator package
RUN pip install --no-cache-dir /workspace/python/password-generator

COPY backend/app /workspace/backend/app

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8080"]
