FROM python:3.12-slim

WORKDIR /workspace

COPY backend/requirements.txt /workspace/requirements.txt
COPY backend/developed_packages.txt /workspace/backend/developed_packages.txt

# Install Python dependencies from requirements.txt and custom packages listed in developed_packages.txt
RUN pip install --no-cache-dir -r /workspace/requirements.txt \
    && pip install --no-cache-dir -r /workspace/backend/developed_packages.txt

COPY backend/app /workspace/backend/app

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8080"]
